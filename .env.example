NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Groq (Chat LLM) ──────────────────────────────────────────────────────────
# From: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ─── Google Gemini (Embeddings) ───────────────────────────────────────────────
